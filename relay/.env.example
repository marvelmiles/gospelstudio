# The address the GospelStudio app is opened on. Only these sites may use the
# relay. Separate several with commas.
ALLOWED_ORIGINS=https://gospelstudio.app,http://localhost:5173

# docker compose only: the public address of this relay. Caddy gets its HTTPS
# certificate for it automatically. Point a DNS A record at this server first.
RELAY_DOMAIN=live.gospelstudio.app

# Optional. How many studios can stream at the same time on this server.
# Each stream uses about 3 to 5 Mbps in, plus the same out per platform.
MAX_SESSIONS=100

# Optional. Streams faster than this are closed, in kbps.
MAX_INGEST_KBPS=12000

# Optional. Path to FFmpeg. In development the bundled ffmpeg-static binary is
# used, and the Docker image sets /usr/bin/ffmpeg.
FFMPEG_PATH=

# Optional. Port and address to listen on.
PORT=8080
HOST=0.0.0.0

# Optional. Set to the number of proxies in front of the relay so rate limits
# see the real visitor address. docker compose sets 1 for Caddy.
TRUST_PROXY_HOPS=0

# Development and testing only. Allows streaming to rtmp servers on private
# networks, which is otherwise blocked.
ALLOW_PRIVATE_DESTINATIONS=false
