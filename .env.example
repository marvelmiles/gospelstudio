# Optional. Lets a phone and a laptop find each other for camera streaming.
# Leave empty and pairing still works offline with a QR code or a pasted code.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com

# Optional. Plausible Analytics for the production site. Tracking only runs in
# production builds served from this domain (or www.), never on localhost or
# deploy previews. Leave empty to turn analytics off.

VITE_PLAUSIBLE_DOMAIN=gospelstudio.app
VITE_PLAUSIBLE_API_BASE_URL=https://plausible.io

# Server only, for the admin analytics dashboard (Netlify Function). Never give
# these a VITE_ prefix: VITE_ values are built into the public JavaScript.
# Set them in Netlify under Site configuration > Environment variables with the
# Functions scope. For local testing with `netlify dev`, put them in .env.

PLAUSIBLE_API_KEY=
PLAUSIBLE_SITE_ID=gospelstudio.app
PLAUSIBLE_API_BASE_URL=https://plausible.io
ANALYTICS_ADMIN_TOKEN=
ANALYTICS_TIMEZONE=Africa/Lagos
