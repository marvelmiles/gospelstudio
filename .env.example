# Optional. Lets a phone and a laptop find each other for camera streaming.
# Leave empty and pairing still works offline with a QR code or a pasted code.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com

# Optional. Plausible Analytics. Tracking only runs in production builds served
# from this domain (or www.), never on localhost. Without a domain, each deploy
# reports under the address it is opened on. The API base URL defaults to
# https://plausible.io.

VITE_PLAUSIBLE_DOMAIN=gospelstudio.app
VITE_PLAUSIBLE_API_BASE_URL=https://plausible.io

# Optional. The address of the GospelStudio relay server
# (the gospelstudio-relay-server project, deployed with Docker on any server).
# It carries live streams to YouTube, Facebook and any RTMP platform, and serves
# the admin analytics reports. This is public, it is built into the app.
# Without it the Stream dialog and the analytics dashboard say they are not set
# up. For local development run the relay server and use http://localhost:8080.

VITE_RELAY_SERVER_URL=https://live.gospelstudio.app
